<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data.breed %> - 詳細</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <header>
    <h1>猫図鑑：<%= data.breed %></h1>
  </header>
  <main class="detail-card">
    <h1>猫図鑑詳細</h1>
    <div style="margin-bottom: 20px;">
        <img src="/public/<%= data.image %>" alt="<%= data.breed %>" style="max-width:100%; border-radius: 8px;">
    </div>
    <div class="detail-item"><span class="detail-label">品種名</span><span class="detail-value"><%= data.breed %></span></div>
    <div class="detail-item"><span class="detail-label">原産地</span><span class="detail-value"><%= data.origin %></span></div>
    <div class="detail-item"><span class="detail-label">性格・特徴</span><span class="detail-value"><%= data.personality %></span></div>

    <div class="button-group">
        <a href="/cats/edit/<%= id %>"><button class="btn-edit">編集する</button></a>
        <a href="/cats/delete/<%= id %>" onclick="return confirm('削除しますか？')"><button class="btn-delete">削除する</button></a>
    </div>
    <a href="/cats" class="btn-back">← 図鑑に戻る</a>
</main>
</body>
</html>