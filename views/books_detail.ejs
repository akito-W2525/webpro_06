<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data.title %> - 詳細</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <header>
    <h1>蔵書管理システム：詳細表示</h1>
  </header>
  <main class="detail-card">
    <h1>書籍詳細</h1>
    <div class="detail-item"><span class="detail-label">書籍名</span><span class="detail-value"><%= data.title %></span></div>
    <div class="detail-item"><span class="detail-label">著者</span><span class="detail-value"><%= data.author %></span></div>
    <div class="detail-item"><span class="detail-label">状態</span><span class="detail-value"><%= data.status %></span></div>
    <div class="detail-item"><span class="detail-label">備考</span><span class="detail-value"><%= data.memo %></span></div>

    <div class="button-group">
        <a href="/books/edit/<%= id %>"><button class="btn-edit">編集する</button></a>
        <a href="/books/delete/<%= id %>" onclick="return confirm('削除しますか？')"><button class="btn-delete">削除する</button></a>
    </div>
    <a href="/books" class="btn-back">← 一覧に戻る</a>
</main>
</body>
</html>